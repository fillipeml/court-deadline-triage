# Copy to .env and fill in. The .env file never goes into the repository.
# Every variable is optional for the demo: DEMO_MODE=true runs offline on fixtures.

# --- Mode ---------------------------------------------------------------------------------
# true = offline: fixture gazette, fixture classifier and a local outbox instead of Graph
DEMO_MODE=true
# true = print alerts and digests instead of delivering them (safe default; set false to deliver)
DRY_RUN=true
# Fixed "today" for the sweep window (YYYY-MM-DD). Demo default: 2026-09-21. Leave empty for today.
REFERENCE_DATE=

# --- Gazette (DJEN / Comunica PJe, public API, no credential) ----------------------------
# Monitored bar numbers, comma-separated, NUMBER/STATE (e.g. 12345/SP,67890/SP).
# The API is ALWAYS queried by bar number: querying by court hits the 10,000 cap.
BAR_NUMBERS=
# Leave empty: the verified default is in the code
DJEN_BASE_URL=
# Days to look back; publications already seen are ignored by the state
WINDOW_DAYS=3

# --- Classification (Claude API) ----------------------------------------------------------
ANTHROPIC_API_KEY=
CLASSIFIER_MODEL=claude-sonnet-5
# true = never call the model: only the pre-filter runs, the rest stays pending
LLM_DISABLED=false
# Max publications classified per run (empty = no limit); cost control during a pilot
TRIAGE_LIMIT=
# Go-live: true = only events validated by the legal team compute a due date
REQUIRE_VALIDATED_CATALOGUE=false

# --- E-mail (Microsoft 365 / Graph, application permission Mail.Send) --------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
EMAIL_SENDER=
# Comma-separated recipients of the daily digest and of failure alerts
EMAIL_RECIPIENTS=
# Weekdays until the due date to flag a row as urgent
URGENT_BUSINESS_DAYS=3

# --- Local state ---------------------------------------------------------------------------
# Defaults: .demo/state.sqlite and .demo/output in demo mode; data/state.sqlite and output/ otherwise
# DB_PATH=
# OUTPUT_DIR=
